# ─────────────────────────────────────────────
# pinterest-art-bot — environment configuration
# ─────────────────────────────────────────────
# Copy to .env and fill in real values.
# NEVER commit the real .env file.

# ── Safety switches (all default OFF) ─────────
# PUBLISH_TO_PINTEREST=true additionally requires a token and strict rights mode.
PUBLISH_TO_PINTEREST=false
# Board creation is a production write; requires PUBLISH_TO_PINTEREST=true.
PINTEREST_AUTO_CREATE_BOARDS=false
PINTEREST_PRODUCTION_SCHEDULE_ENABLED=false

# ── Rights gate ────────────────────────────────
# Strict mode denies attribution-requiring statuses without a credit line.
# Cannot be disabled while PUBLISH_TO_PINTEREST=true.
RIGHTS_ENFORCE_STRICT=true
# Statuses that may be published automatically (JSON list).
# The default is the strictest policy: public_domain and cc0. Anything outside
# the list is blocked permanently — there is no override command.
# RIGHTS_AUTO_PUBLISHABLE_STATUSES=["public_domain","cc0"]

# ── Pinterest API ─────────────────────────────
PINTEREST_ACCESS_TOKEN=
PINTEREST_API_BASE_URL=https://api.pinterest.com/v5
PINTEREST_REQUEST_TIMEOUT_SECONDS=20
# Retries apply to idempotent reads only. Writes are never retried.
PINTEREST_MAX_RETRIES=3
# Client-side call budget, to stay under the published hourly quota.
# 0 disables client-side limiting; server 429s are still handled.
PINTEREST_CALLS_PER_HOUR=900
PINTEREST_CALLS_BURST=20
# Pin budgets: a run may never exceed the daily cap.
PINTEREST_MAX_PINS_PER_RUN=5
PINTEREST_MAX_PINS_PER_DAY=50

# ── Museum API keys (where required) ──────────
# Only sources with a registered adapter have a key setting.
# Rijksmuseum is registered only when its key is present.
RIJKSMUSEUM_API_KEY=

# ── Museum selection ──────────────────────────
DEFAULT_MUSEUM=artic
DEFAULT_MUSEUM_LIMIT=10
# MUSEUM_USER_AGENT=pinterest-artfolio-bot/0.1.0 (+https://example.org; you@example.org)

# ── Board diversity ────────────────────────────
# 0 = no per-board limit.
MAX_PINS_PER_BOARD_PER_DAY=0
# Process least-used boards first, so one movement cannot dominate a run.
BOARD_ROUND_ROBIN=true

# ── Pipeline execution ─────────────────────────
PIPELINE_MAX_CONCURRENCY=4
PIPELINE_MAX_PAGES=5

# ── Classification thresholds ─────────────────
MOVEMENT_CONFIDENCE_AUTO_THRESHOLD=0.8
MOVEMENT_CONFIDENCE_MINIMUM=0.4
# Opt-in: allow MEDIUM confidence classification to auto-route.
ALLOW_MEDIUM_CONFIDENCE_ROUTING=false

# ── Deduplication ─────────────────────────────
# Detect the same work across museums, even with different titles/photos.
CROSS_SOURCE_DEDUP_ENABLED=true
PERCEPTUAL_HASH_ENABLED=true
# Max Hamming distance for a near-duplicate verdict.
PERCEPTUAL_HASH_MAX_DISTANCE=6

# ── Media validation ─────────────────────────
MIN_IMAGE_WIDTH=600
MIN_IMAGE_HEIGHT=600
MAX_IMAGE_FILE_SIZE_MB=20

# ── Published image ───────────────────────────
# Re-encode/downscale museum images before publishing.
IMAGE_PREPARE_ENABLED=true
IMAGE_MAX_WIDTH=1000
IMAGE_JPEG_QUALITY=88
# url    = pass the museum URL (Pinterest fetches it)
# base64 = upload a prepared copy with the Pin (self-contained, larger body)
PIN_MEDIA_MODE=url

# ── Pin text ──────────────────────────────────
PIN_TEMPLATES_PATH=config/pin_templates.yaml
PIN_TITLE_MAX_LENGTH=100
PIN_DESCRIPTION_MAX_LENGTH=800
PIN_ALT_TEXT_MAX_LENGTH=500
# Extra search keywords, as a JSON list.
# PIN_EXTRA_KEYWORDS=["arttrip","arthouse"]

# ── State storage ─────────────────────────────
STATE_DB_PATH=data/state.db
# Retention is applied on every run, dry-run included.
STATE_RESERVATION_TTL_SECONDS=3600
# A write left in flight longer than this is treated as abandoned by a crash.
STATE_INFLIGHT_TIMEOUT_SECONDS=1800
STATE_DRY_RUN_RETENTION_SECONDS=604800
STATE_RUN_RETENTION_SECONDS=2592000
# Media fingerprints are only purged for artworks that can never publish
# (rights-denied/rejected), so deduplication can never weaken.
STATE_FINGERPRINT_RETENTION_SECONDS=15552000
# PID lock that prevents two schedulers from running at once.
SCHEDULER_LOCK_PATH=data/scheduler.lock
# Reconciliation work budget: a backlog is processed in bounded batches.
RECONCILE_MAX_RECORDS=20
RECONCILE_MAX_PAGES_PER_BOARD=10

# ── Board configuration ───────────────────────
# `pinterest-art-bot boards-sync` writes resolved board_id values into this file.
BOARDS_CONFIG_PATH=config/boards.yaml

# ── Scheduler ─────────────────────────────────
SCHEDULER_INTERVAL_SECONDS=3600
# 0 = run until interrupted.
SCHEDULER_MAX_ITERATIONS=0

# ── Logging ───────────────────────────────────
# Logs go to stderr; stdout carries command output.
LOG_LEVEL=INFO
LOG_FORMAT=json
